# ============================================
# ARBITRAGEUR INDEXER (Ponder) CONFIGURATION
# ============================================
# Copy to .env.arbitrageur.indexer. This is the COMPLETE set of variables the indexer reads —
# everything Ponder's config and API touch, and nothing else.
#
# It is a separate file from the bot's on purpose. The two processes are not equally trusted: the
# bot holds a signing key, a kill-switch token and a notifier webhook, and the indexer needs none
# of them. Handing it one file for both puts those secrets in the environment of a process that
# only ever reads the chain — a process that also serves HTTP, which is the one an attacker
# reaches first. Splitting them means a compromised indexer leaks no key.
#
# A few values appear in BOTH files because both processes genuinely need them (the contract
# addresses, the database). Keep them in step: the bot previews vaults against the same VaultSwap
# the indexer watched, and reads the tables the indexer wrote.

# ------ Chain ------

# RPC the indexer reads from. May differ from the bot's CLIENT_RPC_URL — this one wants history and
# generous rate limits; the bot's wants latency.
PONDER_RPC_URL=http://localhost:8545

# Chain ID (default: 1 for mainnet)
CHAIN_ID=1

# Block to start indexing from
START_BLOCK=0

# Polling interval in milliseconds (default: 4000 = 4 seconds).
# Set close to chain block time to avoid wasting RPC credit on duplicate reads.
PONDER_POLLING_INTERVAL=4000

# Multicall3 for the indexer's batched reads. Unset ⇒ Ponder's own default for the chain, which is
# the right answer on any public network; set it for a devnet or a chain Ponder does not know.
# MULTICALL3_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11

# Positions probed per batched `eth_call` when serving /liquidatable-positions (default: 25).
# One probe of a healthy position costs ~177k gas and batching does not amortise it, so 25 is
# ~4.4M gas — inside the 50M cap geth defaults to and the 10M some providers enforce. A batch that
# exceeds the cap reverts whole and costs those positions the cycle (reported as `unscanned`).
# Cost rises ~21k gas per spoke reserve and ~3k per vault on a position, and a liquidatable
# position costs ~247k, so raise this only against a known node cap.
# POSITION_PROBE_CHUNK_SIZE=25

# ------ Contracts it indexes (must match the bot's) ------

# BTCVaultSwap (LLP) — the source of the AddedVault events that build the escrowed-vault set, and
# the contract the API previews each vault against.
VAULT_SWAP_ADDRESS=0x0000000000000000000000000000000000000000

# Only for a deployment that also runs the opt-in liquidation engine, whose candidate list needs the
# position side indexed too. Arbitrage alone needs none of these.
# SPOKE_ADDRESS=0x0000000000000000000000000000000000000000
# ADAPTER_ADDRESS=0x0000000000000000000000000000000000000000
# LENS_ADDRESS=0x0000000000000000000000000000000000000000

# ------ Storage + serving ------

# PostgreSQL connection (start it with `pnpm arbitrageur:db:up`).
DATABASE_URL=postgresql://ponder:ponder@localhost:5433/ponder

# Postgres schema for Ponder's own tables, isolated from the bot's StateStore (which defaults to
# `bot`). Required when using PostgreSQL.
DATABASE_SCHEMA=public

# Port the indexer's API listens on (default: 42070). The bot points PONDER_URL at it.
# PONDER_PORT=42070

# ------ Secrets (optional) ------

# Secrets Manager id holding the indexer's config as JSON, for a deployment that keeps connection
# strings out of the environment: any variable above that is unset is looked up as
# `<CONFIG_SECRET_ID>#<NAME>`. Only PONDER_RPC_URL and DATABASE_URL are resolved this way today.
# CONFIG_SECRET_ID=aave-v4-bots/arbitrageur/indexer
# AWS_REGION=us-east-1
