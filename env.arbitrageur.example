# ============================================
# ARBITRAGEUR SERVICE CONFIGURATION
# ============================================
# Copy this file to .env.arbitrageur and fill in your values.
#
# Two processes read this file: the Ponder INDEXER and the arbitrageur BOT CLIENT.
# Variables are grouped by which one consumes them; a few are shared by both.

# ============================================
# Shared (indexer + bot client)
# ============================================

# VaultSwap contract address
VAULT_SWAP_ADDRESS=0x0000000000000000000000000000000000000000

# PostgreSQL connection (start it with `pnpm arbitrageur:db:up`; port 5433 avoids the
# liquidator's). Required by Ponder; the opt-in liquidation engine also uses it — when
# set — for its crash-safety StateStore (see "Persistence").
DATABASE_URL=postgresql://ponder:ponder@localhost:5433/ponder

# ============================================
# Ponder indexer
# ============================================

# RPC URL for the Ponder indexer
PONDER_RPC_URL=http://localhost:8545

# Chain ID (default: 1 for mainnet)
CHAIN_ID=1

# Block to start indexing from
START_BLOCK=0

# Polling interval in milliseconds (default: 4000 = 4 seconds).
# Set close to chain block time to avoid wasting RPC credit on duplicate reads.
PONDER_POLLING_INTERVAL=4000

# Postgres schema for Ponder's own tables (required when using PostgreSQL)
DATABASE_SCHEMA=public

# ============================================
# Arbitrageur bot client
# ============================================

# ------ Signer & secrets source (optional; defaults preserve local dev) ------
#
# By default the bot uses a LOCAL signer whose key it reads from the ENV var named
# below (ARBITRAGEUR_PRIVATE_KEY). When the arbitrageur runs both engines, this one
# signer is shared by both.
#
# SECRETS_PROVIDER : where secret refs are resolved from.  env (default) | aws
# SIGNER_SOURCE    : how the signer is obtained.           local (default) | aws
# SIGNER_KEY_REF   : (local) the ref holding the key. Defaults to ARBITRAGEUR_PRIVATE_KEY.
#                    With SECRETS_PROVIDER=aws this is a Secrets Manager secret id/ARN.
# KMS_KEY_ID       : (SIGNER_SOURCE=aws) the AWS KMS key id/ARN/alias to sign with.
# SIGNER_ADDRESS   : (aws, optional) expected address; boot fails if the key differs.
# AWS_REGION       : (aws, optional) region for KMS / Secrets Manager.
#
# AWS example:
#   SECRETS_PROVIDER=aws
#   SIGNER_SOURCE=aws
#   KMS_KEY_ID=arn:aws:kms:us-east-1:123:key/abc
#   AWS_REGION=us-east-1
# SECRETS_PROVIDER=env
# SIGNER_SOURCE=local

# ------ Operator alerts (optional; defaults to log-only) ------
#
# The bot always logs risk-gate halts/resumes. NOTIFIER=slack also posts them to a Slack
# incoming webhook (and, under MANUAL mode, the transactions awaiting an operator's signature).
#
# NOTIFIER          : none (default, log-only) | slack
# SLACK_WEBHOOK_REF : (slack) a secret REFERENCE, resolved the same way as the signer key below —
#                     with SECRETS_PROVIDER=env it names another env var holding the URL; with =aws
#                     it is a Secrets Manager id. The reference in `Config` is never the URL itself.
#
# NOTIFIER=slack
# SLACK_WEBHOOK_REF=SLACK_WEBHOOK_URL
# # the referenced var holds the actual webhook (env provider), just like ARBITRAGEUR_PRIVATE_KEY:
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxx

# Arbitrageur private key (must have WBTC to acquire vaults)
# Default: Anvil account #2 (0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC)
# Used by the default local signer; not needed when SIGNER_SOURCE=aws.
ARBITRAGEUR_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# Ponder API URL (the bot queries the indexer here; arbitrageur uses port 42070)
PONDER_URL=http://localhost:42070

# RPC URL for arbitrage transactions
CLIENT_RPC_URL=http://localhost:8545

# WBTC token address
WBTC_ADDRESS=0x0000000000000000000000000000000000000000

# Maximum slippage in basis points (default: 100 = 1%)
MAX_SLIPPAGE_BPS=100

# Polling interval in milliseconds (default: 30000 = 30 seconds)
POLLING_INTERVAL_MS=30000

# Delay between processing vaults in milliseconds (default: 5000 = 5 seconds)
VAULT_PROCESSING_DELAY_MS=5000

# Metrics server port (default: 9091 to avoid conflict with liquidator). Exposes /metrics
# (Prometheus), /health, /ready — and nothing else: the kill switch has its own server on
# RISK_CONTROL_PORT, so this port stays safe to expose to a scrape network.
METRICS_PORT=9091

# ------ Retry configuration (optional) ------

# Maximum retry attempts (default: 3)
RETRY_MAX_ATTEMPTS=3

# Initial retry delay in milliseconds (default: 1000)
RETRY_INITIAL_DELAY_MS=1000

# Maximum retry delay in milliseconds (default: 30000)
RETRY_MAX_DELAY_MS=30000

# Transaction receipt timeout in milliseconds (default: 120000 = 2 minutes)
TX_RECEIPT_TIMEOUT_MS=120000

# ------ Persistence / crash-safety (optional; used by the opt-in liquidation engine) ------
# When DATABASE_URL (Shared, above) is set and the liquidation engine is enabled, the bot
# persists idempotency-keyed intents and a nonce lease so a crash mid-submit never
# double-sends. Unset DATABASE_URL ⇒ no persistence, unchanged.
#
# Postgres schema for the bot's StateStore tables, isolated from Ponder's (default: bot).
# PERSISTENCE_SCHEMA=bot

# ------ Risk gate (all optional; unset ⇒ that guard is off) ------
# The process runs ONE risk gate, shared by the arbitrage engine AND the optional liquidation
# engine: halting it stops both. Every guard below is disabled unless you set its variable, so a
# deployment that sets none of these behaves exactly as it did before the gate existed.

# Auto-halt after this many consecutive failed actions (circuit breaker).
# RISK_MAX_CONSECUTIVE_FAILURES=5

# Profit floor, in 8-decimal sats, applied to the WORST case the tx authorizes
# (vault BTC received - maxWbtcIn, the slippage-adjusted ceiling the swap may charge).
# RISK_MIN_PROFIT=0

# Refuse to act on indexer data older than this. Fail-closed: once set, an action whose source
# timestamp is missing is also blocked.
# RISK_MAX_DATA_STALENESS_MS=60000

# Exposure cap: max actions in flight at once, counted across BOTH engines.
# RISK_MAX_IN_FLIGHT=3

# Boot into HALTED — the bot indexes and reconciles but sends nothing until POST /resume.
# Strictly "true" or "false": a typo like "True" is a startup error, never a silent "keep trading".
# Requires RISK_CONTROL_TOKEN_REF below: without a resume endpoint the bot would halt on every
# restart with no way back, so that combination is rejected at startup.
# RISK_START_HALTED=false

# Code-hash guard: pin the deployed bytecode of the contracts the bot calls. A mismatch (proxy
# upgrade, self-destruct, wrong address) halts the bot. Format: address=keccak256(bytecode).
# The boot check fails CLOSED: if the bytecode cannot be read at startup the bot boots HALTED.
# Later probe failures (RPC blips) do not halt — the next re-check retries.
# RISK_EXPECTED_CODE_HASHES=0xVaultSwap...=0xhash...
# How often to re-verify those hashes (default: 300000 = 5 minutes).
# RISK_CODE_CHECK_INTERVAL_MS=300000

# ------ Kill switch (remote halt/resume) ------
# Set to the NAME of the secret holding the bearer token (resolved through SECRETS_PROVIDER, like
# the signing key — never put the token itself here). When set, a SEPARATE server serves
# POST /halt, POST /resume and GET /status, all requiring `Authorization: Bearer <token>`.
# Unset ⇒ no kill-switch server is started at all, and those paths do not exist anywhere.
#
# It is a separate socket from METRICS_PORT on purpose: /metrics must be scrapeable from the
# cluster, and an endpoint that can stop production trading must not share that exposure.
# RISK_CONTROL_TOKEN_REF=BOT_CONTROL_TOKEN
# BOT_CONTROL_TOKEN=<a long random string>
#
# Where the kill switch listens. Loopback by default — reach it via an SSH tunnel or from on-box.
# Binding 0.0.0.0 puts a trading-stop button on every network this process can see; the bot logs a
# warning if you do. There is no rate limiting or lockout, so do not expose it broadly.
#   curl -XPOST -H "Authorization: Bearer $TOKEN" localhost:9096/halt?reason=incident
#
# NOTE: both services default to 9095. If you run them on the same host with the kill switch
# enabled, set this explicitly — the second one to start fails loudly with EADDRINUSE.
# RISK_CONTROL_PORT=9096
# RISK_CONTROL_HOST=127.0.0.1
